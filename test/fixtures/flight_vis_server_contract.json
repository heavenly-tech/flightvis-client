{
  "_source": "heavenly-tech/flight_vis branch cursor/club-registry-phase2c-07f1 (831f9a0) + pilot anonymous device",
  "_ref": "server-rs/src/club/auth_routes.rs, routes.rs, db_devices_pg.rs, api_tests.rs",
  "routes": {
    "POST /api/club/login": {
      "request": { "email": "string", "password": "string", "installId": "optional string" },
      "response": { "ok": true, "pilot": { "id": "", "name": "", "email": "", "status": "", "role": "" } }
    },
    "POST /api/club/logout": {
      "request": { "installId": "optional string" },
      "response": { "ok": true }
    },
    "GET /api/club/me": {
      "response": { "pilot": { "id": "", "name": "", "email": "", "status": "", "role": "", "licenseNo": "" } }
    },
    "POST /api/club/auth/magic-link": {
      "request": { "email": "string", "locale": "optional string" },
      "response": { "ok": true }
    },
    "GET /api/club/auth/magic?token=": {
      "response": { "ok": true, "pilot": { "id": "", "name": "", "email": "", "status": "", "role": "" } }
    },
    "POST /api/club/auth/webauthn/login/begin": {
      "request": { "email": "string" },
      "response": { "publicKey": {}, "nonce": "string" }
    },
    "POST /api/club/auth/webauthn/login/finish": {
      "request": { "nonce": "string", "credential": {} },
      "response": { "ok": true, "pilot": { "id": "", "name": "", "email": "", "status": "", "role": "" } }
    },
    "POST /api/devices/anonymous": {
      "request": { "label": "string", "locale": "optional string" },
      "response": { "id": "", "token": "" }
    },
    "POST /api/me/devices": {
      "request": { "label": "string", "model": "optional string", "installId": "string" },
      "response": { "id": "", "token": "", "label": "", "created": true }
    },
    "POST /api/checkin": {
      "request": { "token": "string" },
      "response": { "ok": true, "expiresAt": "ISO8601", "id": "optional" }
    },
    "POST /api/flights": {
      "request": { "tail": "string", "visibility": "string", "show_pilot_name_public": false },
      "response": { "id": "", "visibility": "", "showPilotNamePublic": false }
    },
    "POST /api/flights/{id}/end": {
      "response": { "ok": true },
      "errors": { "409": "not active", "404": "not found" }
    },
    "GET /api/me/tails": {
      "response": { "tails": [{ "id": "", "tail": "", "type_code": "" }] }
    },
    "GET /api/clubs/{slug}": {
      "note": "forward-compatible club metadata; landing uses GET /api/c/{slug}/q/{token}/landing",
      "response": { "slug": "", "name": "" }
    }
  },
  "client_paths_used_in_code": "lib/api/flight_vis_api_paths.dart"
}